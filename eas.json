{
  "cli": {
    "version": ">= 17.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "store": {
      "autoIncrement": true,
      "channel": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
